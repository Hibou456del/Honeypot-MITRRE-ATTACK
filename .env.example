# Dynamic Honeypot Platform - Environment Variables

# Database Configuration
DB_PASSWORD=change_this_password_in_production
DB_HOST=localhost
DB_PORT=5432
DB_NAME=honeypot_db
DB_USER=honeypot_user

# Django Configuration
DJANGO_SECRET_KEY=change_this_secret_key_in_production_use_strong_random_string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dashboard Configuration
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# MITRE ATT&CK Configuration
MITRE_AUTO_UPDATE=False
MITRE_API_KEY=optional_api_key_for_auto_update

# Detection Engine
DETECTION_ALERT_THRESHOLD=0.7
DETECTION_CORRELATION_WINDOW=300

# Deception Configuration
DECEPTION_ENABLED=True
DECEPTION_DEFAULT_PROFILE=PROFILE_LOW
DECEPTION_ADAPTATION_COOLDOWN=600

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security
SECURITY_ISOLATE_NETWORK=True
SECURITY_RESTRICT_OUTBOUND=True
SECURITY_MAX_CONNECTIONS_PER_IP=10

# Cowrie Integration (for Linux deployment)
COWRIE_LOG_PATH=/var/log/cowrie
COWRIE_INTEGRATION_MODE=host

# Platform
PLATFORM=windows
ENVIRONMENT=development